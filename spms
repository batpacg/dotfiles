# ==============================================================================

error() {
	printf "\033[31merror: \033[0m%s" "$*"
	exit 1
}

help() {
	cat <<- EOF
		Simple package management script.

		Usage: $me [opstions] [args]
	EOF
}

main() {
	[ -z "$1" ] && error "Nothing specified. Use $me --help/-h for help."
	case "$1" in
		pacman)
			install_cmd="sudo pacman -S"
			;;
		aur)
			install_cmd="yay -S"
			;;
		flatpak)
			install_cmd="flatpak install"
			;;
		*)
			exit 1
			;;
	esac
	arr_name="$*"
	arr_name="${arr_name// /_}"
	pkgs="$(eval "echo \"\${$arr_name[@]}\"")"
	$install_cmd $pkgs
	# awk -F '_' '/^.*=\($/ { print $0 }' "$full"
}

# ==============================================================================

main "$@"

exit
