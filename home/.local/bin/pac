#!/usr/bin/env bash

fzf="fzf --reverse --wrap"
pacman_query_cmd="pacman -Ss --color=always"
pacman_sync_cmd="sudo pacman -S"

main() {
	local subcommand="$1"
	shift
	case "$subcommand" in
		-*) sudo pacman "$subcommand" "$@" ;;
		q | query) $pacman_query_cmd "$@" ;;
		fq | fquery)
			$pacman_query_cmd "$@" --color=always | paste - - | $fzf
			;;
		s | sync) $pacman_sync_cmd "$@" ;;
		fs | fsync)
			local pkg
			pkg="$($pacman_query_cmd "$@" | paste - - | $fzf)"
			[ -z "$pkg" ] && return
			pkg="${pkg#*/}"  # trim left
			pkg="${pkg%% *}" # trim right
			$pacman_sync_cmd "$pkg"
			;;
		u | update) sudo pacman -Syyu ;;
		r | remove) sudo pacman -Rs "$@" ;;
		*) exit 1 ;;
	esac
}

main "$@"

exit 0
