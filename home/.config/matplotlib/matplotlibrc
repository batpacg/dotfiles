## Background
figure.facecolor: "#282828"
axes.facecolor: "#282828"
axes.edgecolor: "#fbf1c7"
axes.linewidth: 0.5

## Font
font.family: monospace
font.monospace: JetBrainsMono NF

## Text
text.color: "#fbf1c7"
axes.labelcolor: "#fbf1c7"

## Lines
axes.prop_cycle: cycler('color', ['fabd2f', 'b8bb26', '83a598', '8ec07c', 'fe8019', 'fb4934'])
lines.linewidth: 1
# Seems to make 'cross' markers invisible.
# lines.markeredgecolor: 'none'

## Ticks
xtick.top: False
ytick.right: False

xtick.color: "#fbf1c7"
xtick.labelsize: 11
ytick.color: "#fbf1c7"
ytick.labelsize: 11

## Grid
# Can lead to problems with routines that automatically turn this on.
# axes.grid: True
axes.axisbelow: True
grid.color: "#3c3836"
grid.linewidth: 0.5

## Scatter Plot
scatter.marker: .

## Figure Output
savefig.dpi: 300
